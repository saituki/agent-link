[package]
name = "sai-paper-tui"
version = "0.1.0"
edition = "2024"
description = "Citation list TUI for sai-paper-core — papr companion (herdr pane)"
authors = []
license = "MIT"

[[bin]]
name = "sai-paper-tui"
path = "src/main.rs"

[dependencies]
anyhow = "1.0"
chrono = { version = "0.4", features = ["serde"] }
clap = { version = "4.5", features = ["derive"] }
crossterm = "0.28"
directories = "6.0"
ratatui = "0.29"
rusqlite = { version = "0.32", features = ["chrono", "bundled"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
tokio = { version = "1.0", features = ["rt-multi-thread", "macros", "time"] }
toml = "0.8"
thiserror = "2.0"
reqwest = { version = "0.12", default-features = false, features = ["rustls-tls", "json"] }
url = "2.5"
