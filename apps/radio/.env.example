# .env の書き方見本
# このファイルを `.env` という名前でコピーして使います:
#   cp .env.example .env
# 値はすべて仮のものなので，自分の環境に合わせて書き換えてください．
# 注意: 本物のAPIキーは絶対にこのファイルに書いたまま人に見せないこと．

# --- 要約・質問応答に使うLLM (esperanto経由) ---
# モデル名は `<プロバイダ>/<モデル>` の形で書きます．
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
# LLMのAPIキーはここかシェルの設定ファイル(~/.zshrc など)に書きます．
# OpenRouterを使う場合の例:
# OPENROUTER_API_KEY=sk-xxxxxxxx

# --- 質問機能 (Gemini Live API) ---
# Google の APIキー．質問機能を使うには必須です．
# (Google AI Studio で発行できます)
GEMINI_API_KEY=
# Live API で使うモデル．動作確認済みの版に固定しています．変えないでください．
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
# 質問用の「合鍵(トークン)」の有効期限(秒)．既定30分．短めが安全です．
GEMINI_TOKEN_TTL_SEC=1800

# --- 音声の圧縮 ---
# 解説モードの音声を小さくするときのビットレート．朗読なら 64k で十分です．
AUDIO_BITRATE=64k

# --- 音声合成 (AivisSpeech Engine) ---
# AivisSpeech Engine を起動したアドレス．普通はこのままで動きます．
AIVISSPEECH_BASE_URL=http://127.0.0.1:10101
# 解説モードで使う声のID．`http://127.0.0.1:10101/speakers` をブラウザで開いて確認します．
AIVISSPEECH_SPEAKER=0

# --- その他 ---
# PDF→Markdown変換に使う docling コマンドの場所．
DOCLING_BIN=docling
# PDF変換が時間切れになるまでの秒数．
DOCLING_TIMEOUT_SEC=300
# 簡単なアクセス制限をかけたいときだけ好きな文字列を書きます．空のままなら制限なしです．
SAI_RADIO_TOKEN=
