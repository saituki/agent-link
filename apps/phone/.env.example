# 例: cp .env.example .env して値を書き換える
# 合言葉。iPhone 側とここを同じにする。空のままなら認証なし（開発用）。
SAI_PHONE_TOKEN=
# 待ち受けポート。既定 8200。
SAI_PHONE_PORT=8200
# Project タブ・List 画面が呼ぶ sai-moon-link（既定は PATH 上の sai-moon-link）。
SAI_LINK_BIN=sai-moon-link
# 登録簿 ~/.sai-moon の置き場。空なら $HOME/.sai-moon（テスト用に一時フォルダを指せる）。
# SAI_SAI_HOME=
# Papers タブが呼ぶ sai-moon-paper（PATH に無いため既定は絶対パス）。
SAI_PAPER_BIN=/Users/touta/workdir/Sai/sai-moon/target/release/sai-moon-paper
# sai-moon-paper を呼ぶ cwd / SAI_PAPER_ROOT は選んだプロジェクトの root（17 §3.2）。
# API キーはプロジェクトの .env → ~/.sai-moon/paper.env（sai-moon-paper 側の優先順位）から読む。
# Radio の中継先（sai-moon-radio の場所・既定は 127.0.0.1:8201）。
SAI_RADIO_URL=http://127.0.0.1:8201
# sai-moon-radio に付ける合言葉。sai-moon-radio 側に SAI_RADIO_TOKEN を設定したときだけ同じ値を書く（未設定なら空のまま）。
SAI_RADIO_TOKEN=
# Usage タブが使う OpenRouter のアカウント（名前=キーの入った環境変数名・カンマ区切り）。
# 未設定なら main=OPENROUTER_API_KEY として動く。
SAI_PHONE_OPENROUTER_ACCOUNTS=main=OPENROUTER_API_KEY
# 2 つ目のアカウントを使うときは名前とキーを足す（例）:
# SAI_PHONE_OPENROUTER_ACCOUNTS=main=OPENROUTER_API_KEY,sub=OPENROUTER_API_KEY_2
# OPENROUTER_API_KEY_2=sk-or-...
