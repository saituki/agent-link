<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sai-moon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/touta/workdir/Sai/sai-moon/apps/phone/.venv/bin/uvicorn</string>
        <string>sai_phone.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8200</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/touta/workdir/Sai/sai-moon/apps/phone</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/touta/workdir/Sai/sai-moon/apps/phone/src</string>
        <!-- launchd から起動すると PATH が短く sai-moon-link / sai-moon-paper が見つからないため補う（11 §4.B） -->
        <key>PATH</key>
        <string>/Users/touta/workdir/Sai/sai-moon/target/release:/Users/touta/workdir/Sai/sai-moon/target/debug:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/touta/workdir/Sai/sai-moon/apps/phone/src/data/sai-moon.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/touta/workdir/Sai/sai-moon/apps/phone/src/data/sai-moon.log</string>
</dict>
</plist>
