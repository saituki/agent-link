# 例: cp .env.example .env して値を書き換える。.env は git の追跡外。
# 既に .env があるときは上書きせず、足りないキーだけ追記すること。

# MLflow のバージョン。python:3.12-slim で動く 3.x を入れる。
MLFLOW_VERSION=3.16.0

# --- postgres（backend store） ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=
POSTGRES_DB=mlflow-db

# --- MinIO（local experiment の成果物） ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Caddy の Basic 認証 ---
# ユーザー名。LAN の PC / DOK / 手元の curl はこの名前で入る。
MLFLOW_BASIC_USER=mlflow
# 平文。パスワードマネージャの値をここに写す（agent は .sai/settings.json にも同じ値を書く）。
MLFLOW_BASIC_PASSWORD=
# bcrypt ハッシュ。作り方は README §3。docker run --rm caddy:2 caddy hash-password
MLFLOW_BASIC_PASSWORD_HASH=

# --- フェーズ2（U04）で使う。フェーズ1では空のままにしてよい ---
# さくらの S3 エンドポイント（コントロールパネルの表示値。例 s3.isk01.sakurastorage.jp）
SAKURA_S3_ENDPOINT=
# さくらの S3 リージョン（コントロールパネルの表示値。例 jp-north-1）
SAKURA_S3_REGION=
SAKURA_S3_ACCESS_KEY=
SAKURA_S3_SECRET_KEY=
# さくらのバケットと、その中の MLflow 用の folder
SAKURA_BUCKET=hps-data-2026
SAKURA_PREFIX=saito260927/mlflow
