#!/bin/sh
# agent-link-web: Web の窓口の CLI（apps/web/.venv の Python で動かす）
#
# PATH にリンクを置いて呼ばれても動くよう、リンクをたどってから場所を求める。
self=$(readlink -f "$0" 2>/dev/null || echo "$0")
app=$(cd "$(dirname "$self")/.." && pwd -P)
PYTHONPATH="$app/src${PYTHONPATH:+:$PYTHONPATH}" exec "$app/.venv/bin/python" -m agent_link_web.webcli "$@"
