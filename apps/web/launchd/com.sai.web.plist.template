<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sai.web</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/apps/web/bin/sai-web</string>
        <string>serve</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__/apps/web</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__REPO__/apps/web/src</string>
        <!-- launchd から起動すると PATH が短く sai-link / sai-paper が見つからないため補う（11 §4.B） -->
        <key>PATH</key>
        <string>__REPO__/target/release:__REPO__/apps/web/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__SAI_HOME__/web/sai-web.log</string>
    <key>StandardErrorPath</key>
    <string>__SAI_HOME__/web/sai-web.log</string>
</dict>
</plist>
