#!/bin/sh
# Web が CLI を呼ぶとき、プロジェクトのコンテナの中で動かす中継（共有契約 C7）。
#
# このファイルを `sai-link`・`sai-paper`・`sai-sci` の名前でリンクして使う
# （例: /opt/sai/bin/sai-link -> sai-in-container）。Web は実行ファイルの場所
# （SAI_LINK_BIN・SAI_PAPER_BIN・SAI_SCI_BIN）をこのリンクに向けるだけでよい。
# 呼ばれた名前（basename "$0"）の CLI を、そのプロジェクトのコンテナの中で動かす。
#
# - プロジェクトの要らない命令（schema など。SAI_PROJECT_ROOT が空）は、
#   使い捨てのコンテナで動かす（外への口を与えない）。
# - プロジェクトの命令は、動いているコンテナに `docker exec` で入って動かす。
#   渡す環境変数は SAI_PROJECT_ROOT と SAI_ORIGIN の 2 つだけ（Web の合言葉・
#   API キーはコンテナへ渡さない）。
# - 終了コード・標準出力・標準エラーは `docker` がそのまま返す（CLI の約束が
#   そのまま Web に届く）。
# - `docker` は rootless の socket を使う（DOCKER_HOST は systemd のひな形で渡す）。
set -u

bin=$(basename "$0")
image=${SAI_IMAGE:-sai-tree:latest}

if [ -z "${SAI_PROJECT_ROOT:-}" ]; then
  # プロジェクトの要らない命令は使い捨てのコンテナで動かす。
  exec docker run --rm -i --network none "$image" "$bin" "$@"
fi

root=$SAI_PROJECT_ROOT
# コンテナの名前は `sai-<root のフォルダ名>`（C7）。`..` の入った紛らわしい場所は
# 受け付けない（フォルダ名が化けて別のコンテナを指しかねない）。
case "$root" in
  *"/../"*|*"/.."|".."|".")
    echo "プロジェクトの場所が正しくありません: $root" >&2
    exit 2
    ;;
esac
name=$(basename "$root")
case "$name" in
  *[!a-z0-9-]*|-*|"")
    echo "プロジェクトの名前が正しくありません: $name" >&2
    exit 2
    ;;
esac

ctr="sai-$name"
if [ "$(docker inspect -f '{{.State.Running}}' "$ctr" 2>/dev/null)" != "true" ]; then
  echo "プロジェクトのコンテナが動いていません（Projects から起動してください）" >&2
  exit 4
fi

exec docker exec -i -w "$root" \
  -e SAI_PROJECT_ROOT -e SAI_ORIGIN "$ctr" "$bin" "$@"
