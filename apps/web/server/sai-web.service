# sai-tree の Web の窓口を systemd のシステムサービスとして動かすひな形。
#
# 使い方（docs/server.md の 7）:
#   1. このファイルの <…> を埋める（<repo> はリポジトリの絶対パス、<sai-uid> は `id -u sai`、
#      <machine>.<tailnet>.ts.net は `tailscale status` の自分の名前の全体）。
#   2. /etc/systemd/system/sai-web.service に置く。
#   3. sudo systemctl daemon-reload && sudo systemctl enable --now sai-web
#
# rootless の dockerd は `sai` の user サービスなので、After= で順番を付けられない。
# Web は docker が動いていないとき 503 を返す（U09）ので、起動の順番は問わない。

[Unit]
Description=sai-tree Web（研究プロジェクトの窓口）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sai
Group=sai
WorkingDirectory=<repo>
# 待ち受ける住所と CLI の場所（C7）。
# CLI はコンテナの中継（sai-in-container へのリンク）に向ける。
Environment=SAI_WEB_USERS_ROOT=/srv/sai/users
Environment=SAI_LINK_BIN=/opt/sai/bin/sai-link
Environment=SAI_PAPER_BIN=/opt/sai/bin/sai-paper
Environment=SAI_SCI_BIN=/opt/sai/bin/sai-sci
Environment=SAI_IMAGE=sai-tree:latest
Environment=SAI_WEB_NO_WATCH=0
# sai-ts の入口（段階 B）。127.0.0.1 だけで待ち、tailscale serve --https=8443 で外へ出す（docs/server.md の 9）。
Environment=SAI_WEB_TS_PORT=8210
Environment=SAI_WEB_TS_URL=https://<machine>.<tailnet>.ts.net:8443
# rootless Docker の socket（`sai` の user サービス）。
Environment=DOCKER_HOST=unix:///run/user/<sai-uid>/docker.sock
Environment=XDG_RUNTIME_DIR=/run/user/<sai-uid>
# 0.0.0.0 で待ち受ける。届く範囲は防火壁（ufw）で tailscale0 とコンテナに絞る
# （rootless のコンテナからはホストの 127.0.0.1 に届かない・docs/server.md の 8）。
ExecStart=<repo>/apps/web/bin/sai-web serve --host 0.0.0.0 --port 8200
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
