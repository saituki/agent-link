# 例: cp .env.example .env して値を書き換える
# 合言葉。iPhone 側とここを同じにする。空のままなら認証なし（開発用）。
AGENT_LINK_WEB_TOKEN=
# 待ち受けポート。既定 8200。
AGENT_LINK_WEB_PORT=8200
# Project タブ・List 画面が呼ぶ agent-link（既定は PATH 上の agent-link）。
AGENT_LINK_BIN=agent-link
# 登録簿 ~/.agent-link の置き場。空なら $HOME/.agent-link（テスト用に一時フォルダを指せる）。
# AGENT_LINK_HOME=
# Usage タブが使う OpenRouter のアカウント（名前=キーの入った環境変数名・カンマ区切り）。
# 未設定なら main=OPENROUTER_API_KEY として動く。
AGENT_LINK_WEB_OPENROUTER_ACCOUNTS=main=OPENROUTER_API_KEY
# 2 つ目のアカウントを使うときは名前とキーを足す（例）:
# AGENT_LINK_WEB_OPENROUTER_ACCOUNTS=main=OPENROUTER_API_KEY,sub=OPENROUTER_API_KEY_2
# OPENROUTER_API_KEY_2=sk-or-...
