#!/usr/bin/env python3
"""local の実行先: この PC でコマンドを切り離して動かす（分配器 exp_exec.py から呼ばれる）。

状態は `<sai_home>/exec/local/<job_id>/` のファイルに残す:
    log        コマンドの標準出力と標準エラー
    pid        切り離したシェルの pid（プロセスグループの先頭）
    exit_code  コマンドの終了コード（終わったときだけ）
    cancelled  中止の印
"""

import json
import os
import signal
import subprocess
import sys
from pathlib import Path


def sai_home() -> Path:
    value = os.environ.get("SAI_HOME")
    return Path(value) if value else Path.home() / ".sai"


ROOT = sai_home() / "exec" / "local"


def job_dir() -> Path:
    return ROOT / os.environ["EXP_JOB_ID"]


def alive(pid: int) -> bool:
    # ponytail: pid の使い回しは見ない。長く放置したジョブの誤判定が問題になったら開始時刻も残す
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def state_of(folder: Path) -> str:
    code = folder / "exit_code"
    if code.is_file():
        if code.read_text().strip() == "0":
            return "done"
        return "cancelled" if (folder / "cancelled").exists() else "failed"
    pid = folder / "pid"
    if not pid.is_file():
        return "queued"
    if alive(int(pid.read_text())):
        return "running"
    return "cancelled" if (folder / "cancelled").exists() else "lost"


def running_count() -> int:
    if not ROOT.is_dir():
        return 0
    return sum(1 for f in ROOT.iterdir() if f.is_dir() and state_of(f) in ("queued", "running"))


def cmd_run(argv: list[str]) -> int:
    if not argv:
        print("実行するコマンドがありません", file=sys.stderr)
        return 2
    limit = int(os.environ.get("EXP_MAX_JOBS", "4"))
    if running_count() >= limit:
        print(f"同時実行の上限（{limit}）に達しています", file=sys.stderr)
        return 1
    folder = job_dir()
    folder.mkdir(parents=True, exist_ok=True)
    # コマンドの終了コードを、終わったときに 1 度だけ書く（中止で殺されたときは書かれない）
    wrapper = '"$@" >>"$0/log" 2>&1; echo $? >"$0/exit_code"'
    proc = subprocess.Popen(
        ["sh", "-c", wrapper, str(folder), *argv],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    (folder / "pid").write_text(str(proc.pid))
    return 0


def cmd_status(_: list[str]) -> int:
    print(json.dumps({"state": state_of(job_dir())}))
    return 0


def cmd_logs(argv: list[str]) -> int:
    n = int(argv[argv.index("-n") + 1]) if "-n" in argv else 50
    log = job_dir() / "log"
    if log.is_file():
        sys.stdout.write("".join(log.read_text(errors="replace").splitlines(keepends=True)[-n:]))
    return 0


def cmd_cancel(_: list[str]) -> int:
    folder = job_dir()
    (folder / "cancelled").write_text("")
    pid = folder / "pid"
    if pid.is_file():
        try:
            os.killpg(int(pid.read_text()), signal.SIGTERM)
        except ProcessLookupError:
            pass
    return 0


def cmd_check(_: list[str]) -> int:
    from shutil import which

    if which("uv") is None:
        print("uv が見つかりません（実験のスクリプトは uv run で動かします）", file=sys.stderr)
        return 1
    return 0


VERBS = {"run": cmd_run, "status": cmd_status, "logs": cmd_logs, "cancel": cmd_cancel, "check": cmd_check}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in VERBS:
        print("usage: adapter run|status|logs|cancel|check", file=sys.stderr)
        sys.exit(2)
    sys.exit(VERBS[sys.argv[1]](sys.argv[2:]))
