#!/usr/bin/env python3
"""dok の実行先: さくらの高火力 DOK で動かす（分配器 exp_exec.py から呼ばれる）。

同じフォルダの dok.py の `ssh-run`（公開 image を SSH 有効で起動 → ssh でスクリプトを流す →
**必ずタスクを止める**）を、切り離した運転役（この adapter の `_drive`）に動かさせる。
状態は `<sai_home>/exec/dok/<job_id>/` のファイルに残す（local の実行先と同じ形）:
    script.sh  コンテナへ流すスクリプト（コードと env と準備とコマンド）
    log        dok.py の出力
    pid        運転役の pid
    exit_code  dok.py の終了コード（終わったときだけ）
    cancelled  中止の印

**課金に関わる約束**: 中止は運転役に SIGTERM を送る。dok.py が受けて DOK のタスクを止める。
dok.py の終了コード 4（タスクを止められなかった）は state を failed にし、log に警告が残る。
そのときは `python3 dok.py list` / `cancel <task_id>` で手で確かめること。
"""

import base64
import io
import json
import os
import shlex
import signal
import subprocess
import sys
import tarfile
import tomllib
from pathlib import Path

DIR = Path(os.environ.get("EXP_TARGET_DIR", "."))
JOB = os.environ.get("EXP_JOB_ID", "")
EXCLUDES = {".git", ".venv", "__pycache__", "node_modules", ".sai", "mlruns"}
# ホスト側へ送る環境変数の名前の頭（dok.py が MLflow 用の値を別に渡すが、追加の MLFLOW_* も送る）
FORWARD_PREFIXES = ("MLFLOW_", "AWS_")


class Fail(Exception):
    pass


def sai_home() -> Path:
    value = os.environ.get("SAI_SAI_HOME")
    return Path(value) if value else Path.home() / ".sai-moon"


def job_dir() -> Path:
    return sai_home() / "exec" / "dok" / JOB


def config() -> dict:
    path = DIR / "target.toml"
    return (tomllib.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}).get("dok") or {}


def alive(pid: int) -> bool:
    # ponytail: pid の使い回しは見ない。長く放置したジョブの誤判定が問題になったら開始時刻も残す
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def state_of(folder: Path) -> str:
    code = folder / "exit_code"
    if code.is_file():
        if code.read_text().strip() == "0":
            return "done"
        return "cancelled" if (folder / "cancelled").exists() else "failed"
    pid = folder / "pid"
    if not pid.is_file():
        return "queued"
    if alive(int(pid.read_text())):
        return "running"
    return "cancelled" if (folder / "cancelled").exists() else "lost"


def active_count() -> int:
    root = job_dir().parent
    if not root.is_dir():
        return 0
    return sum(1 for f in root.iterdir() if f.is_dir() and state_of(f) in ("queued", "running"))


def keep(info: tarfile.TarInfo) -> tarfile.TarInfo | None:
    """送らないもの（.git・.venv など）を外す。"""
    parts = Path(info.name).parts
    if any(part in EXCLUDES for part in parts) or info.name.endswith(".pyc"):
        return None
    return info


def pack_code(limit_mb: float) -> str:
    """cwd のコードを tar.gz → base64 にする（PTY に流すので 76 桁で折る）。"""
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
        tar.add(".", arcname=".", filter=keep)
    if buf.tell() > limit_mb * 1024 * 1024:
        raise Fail(f"送るコードが {limit_mb:g} MB を超えています。データや成果物を cwd から外してください")
    return base64.encodebytes(buf.getvalue()).decode()


def build_script(argv: list[str], cfg: dict) -> str:
    """コンテナの中で流すスクリプト。コード → 環境変数 → 準備 → コマンドの順。"""
    lines = ["set -e", "mkdir -p /work && cd /work", "base64 -d <<'__CODE__' | tar xz", pack_code(float(cfg.get("max_code_mb", 5))).rstrip("\n"), "__CODE__"]
    for name in sorted(n for n in os.environ if n.startswith(FORWARD_PREFIXES)):
        if "\n" not in os.environ[name]:
            lines.append(f"export {name}={shlex.quote(os.environ[name])}")
    lines += list(cfg.get("setup") or [])
    lines += ["set +e", shlex.join(argv)]
    return "\n".join(lines) + "\n"


def cmd_run(argv: list[str]) -> int:
    if not argv:
        raise Fail("実行するコマンドがありません")
    cfg = config()
    if active_count() >= int(os.environ.get("EXP_MAX_JOBS", "1")):
        raise Fail("DOK は同時に 1 タスクだけです。動いているジョブが終わるまで待ってください")
    folder = job_dir()
    folder.mkdir(parents=True, exist_ok=True)
    script = folder / "script.sh"
    script.write_text(build_script(argv, cfg), encoding="utf-8")
    script.chmod(0o600)  # 環境変数の中に鍵が入る
    proc = subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "_drive"],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True, env=os.environ,
    )
    (folder / "pid").write_text(str(proc.pid))
    return 0


def dok_argv(cfg: dict, script: Path) -> list[str]:
    argv = [sys.executable, str(DIR / "dok.py")]
    if cfg.get("env_file"):
        argv += ["--env-file", str(Path(cfg["env_file"]).expanduser())]
    argv += ["ssh-run", "--script", str(script), "--name", f"exp-{JOB}"]
    for flag, key in (("--plan", "plan"), ("--image", "image"), ("--limit-sec", "limit_sec"),
                      ("--hold-sec", "hold_sec"), ("--key", "key"), ("--experiment", "experiment")):
        if cfg.get(key) not in (None, ""):
            argv += [flag, str(cfg[key])]
    uri = os.environ.get("MLFLOW_TRACKING_URI")
    if uri:
        argv += ["--mlflow-url", uri]
    return argv


def cmd_drive(_: list[str]) -> int:
    """切り離された運転役。dok.py を動かし、終了コードを書く。TERM は dok.py に渡して止め終わるまで待つ。"""
    folder = job_dir()
    cfg = config()
    with open(folder / "log", "ab") as log:
        proc = subprocess.Popen(dok_argv(cfg, folder / "script.sh"), stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)

        def forward(signum, _frame):
            (folder / "cancelled").write_text("")
            proc.send_signal(signal.SIGTERM)  # dok.py が受けて、DOK のタスクを必ず止める

        signal.signal(signal.SIGTERM, forward)
        signal.signal(signal.SIGINT, forward)
        code = proc.wait()
    (folder / "exit_code").write_text(str(code))
    return 0


def cmd_status(_: list[str]) -> int:
    print(json.dumps({"state": state_of(job_dir())}))
    return 0


def cmd_logs(argv: list[str]) -> int:
    n = int(argv[argv.index("-n") + 1]) if "-n" in argv else 50
    log = job_dir() / "log"
    if log.is_file():
        sys.stdout.write("".join(log.read_text(errors="replace").splitlines(keepends=True)[-n:]))
    return 0


def cmd_cancel(_: list[str]) -> int:
    folder = job_dir()
    (folder / "cancelled").write_text("")
    pid = folder / "pid"
    if pid.is_file() and not (folder / "exit_code").is_file():
        try:
            os.kill(int(pid.read_text()), signal.SIGTERM)
        except ProcessLookupError:
            pass
    return 0


def cmd_check(_: list[str]) -> int:
    """認証だけ確かめる（課金されない）。秘密の値は出さない。"""
    cfg = config()
    argv = [sys.executable, str(DIR / "dok.py")]
    if cfg.get("env_file"):
        argv += ["--env-file", str(Path(cfg["env_file"]).expanduser())]
    proc = subprocess.run(argv + ["auth"], capture_output=True, text=True, timeout=60)
    if proc.returncode != 0 or "(未同意)" in proc.stdout:
        last = (proc.stderr or proc.stdout).strip().splitlines()
        raise Fail(last[-1] if last else "DOK の認証を確かめられません")
    key = Path(cfg.get("key", "~/.ssh/dok_key")).expanduser()
    if not key.is_file():
        raise Fail(f"ssh の秘密鍵がありません: {key}（`python3 dok.py ssh-key` を実行する）")
    return 0


VERBS = {"run": cmd_run, "_drive": cmd_drive, "status": cmd_status, "logs": cmd_logs, "cancel": cmd_cancel, "check": cmd_check}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in VERBS:
        print("usage: adapter run|status|logs|cancel|check", file=sys.stderr)
        sys.exit(2)
    try:
        sys.exit(VERBS[sys.argv[1]](sys.argv[2:]))
    except Fail as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print("時間切れです", file=sys.stderr)
        sys.exit(1)
