{
  "mcpServers": {
    "chrome-devtools": {
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless",
        "--isolated",
        "--no-category-memory",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "command": "npx",
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    },
    "donsetch": {
      "args": [
        "mcp",
        "--supervised"
      ],
      "command": "donsetch"
    },
    "headroom": {
      "args": [
        "mcp",
        "serve"
      ],
      "command": "headroom"
    },
    "sai": {
      "args": [
        "mcp",
        "serve"
      ],
      "command": "/Users/touta/.local/bin/sai-moon-link"
    },
    "serena": {
      "args": [
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "claude-code",
        "--open-web-dashboard",
        "False"
      ],
      "command": "uvx"
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@0.0.82",
        "--browser",
        "webkit",
        "--device",
        "iPhone 15",
        "--headless",
        "--isolated"
      ],
      "command": "npx"
    }
  }
}
